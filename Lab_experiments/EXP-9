<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">

<title>TechSavvy | Online Electronics Shopping</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Segoe UI',sans-serif;
scroll-behavior:smooth;
}

body{
background:#f4f8fb;
color:#333;
}

header{
position:fixed;
top:0;
width:100%;
display:flex;
justify-content:space-between;
align-items:center;
padding:18px 8%;
background:#0d47a1;
z-index:1000;
}

.logo{
font-size:30px;
font-weight:bold;
color:#fff;
}

nav a{
color:white;
text-decoration:none;
margin:0 16px;
font-weight:600;
}

nav a:hover{
color:#ffd54f;
}

.btn{
padding:12px 24px;
border:none;
border-radius:30px;
background:white;
color:#0d47a1;
font-weight:bold;
cursor:pointer;
transition:.3s;
}

.btn:hover{
transform:translateY(-3px);
}

.hero{
height:100vh;
background:linear-gradient(rgba(0,0,0,.5),rgba(0,0,0,.5)),
url("https://images.unsplash.com/photo-1519389950473-47ba0277781c?w=1600") center/cover;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
color:white;
}

.hero h1{
font-size:58px;
margin-bottom:20px;
}

.hero p{
font-size:20px;
margin-bottom:30px;
}

section{
padding:90px 8%;
}

.title{
text-align:center;
font-size:42px;
color:#0d47a1;
margin-bottom:45px;
}

.search{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
}

.search input,
.search select{
padding:15px;
border:1px solid #ccc;
border-radius:8px;
}

.products{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:25px;
}

.product{
background:white;
border-radius:15px;
overflow:hidden;
box-shadow:0 10px 20px rgba(0,0,0,.1);
}

.product img{
width:100%;
height:220px;
object-fit:cover;
}

.product div{
padding:20px;
}

.cards{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:25px;
}

.card{
background:white;
padding:25px;
border-radius:15px;
box-shadow:0 10px 20px rgba(0,0,0,.1);
transition:.3s;
}

.card:hover{
transform:translateY(-8px);
}

.card h2{
color:#0d47a1;
margin-bottom:15px;
}

.card ul{
padding-left:20px;
}

.card li{
margin:10px 0;
}

.contact{
display:grid;
grid-template-columns:1fr 1fr;
gap:30px;
}

.contact form{
background:white;
padding:25px;
border-radius:15px;
box-shadow:0 10px 20px rgba(0,0,0,.1);
}

.contact input,
.contact textarea{
width:100%;
padding:15px;
margin:10px 0;
border:1px solid #ccc;
border-radius:8px;
}

footer{
background:#222;
color:white;
text-align:center;
padding:30px;
}

@media(max-width:900px){

nav{
display:none;
}

.hero h1{
font-size:40px;
}

.contact{
grid-template-columns:1fr;
}

}

</style>

</head>

<body>


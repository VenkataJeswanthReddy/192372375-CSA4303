<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Infinity Library | Smart Library Management System</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Segoe UI,Tahoma,Geneva,Verdana,sans-serif;
scroll-behavior:smooth;
}

body{

background:linear-gradient(-45deg,#0f2027,#203a43,#2c5364,#141E30);
background-size:400% 400%;
animation:bg 15s ease infinite;
color:white;

}

@keyframes bg{

0%{background-position:0% 50%;}
50%{background-position:100% 50%;}
100%{background-position:0% 50%;}

}

header{

position:fixed;
top:0;
width:100%;
display:flex;
justify-content:space-between;
align-items:center;
padding:18px 8%;
background:rgba(255,255,255,.08);
backdrop-filter:blur(18px);
z-index:999;

}

.logo{

font-size:30px;
font-weight:bold;
color:#00e6ff;

}

nav a{

color:white;
text-decoration:none;
margin:0 18px;
font-weight:600;
transition:.3s;

}

nav a:hover{

color:#00ffff;

}

.btn{

padding:12px 24px;
border:none;
border-radius:30px;
background:#00d9ff;
color:black;
font-weight:bold;
cursor:pointer;
transition:.3s;

}

.btn:hover{

transform:translateY(-3px);
box-shadow:0 10px 25px cyan;

}

.hero{

padding-top:150px;
display:flex;
justify-content:space-between;
align-items:center;
padding-left:8%;
padding-right:8%;
min-height:100vh;

}

.hero-text{

width:55%;

}

.hero-text h1{

font-size:58px;
line-height:1.2;
margin-bottom:20px;

}

.hero-text span{

color:#00ffff;

}

.hero-text p{

font-size:19px;
color:#ddd;
line-height:32px;
margin-bottom:30px;

}

.hero-image{

width:38%;

}

.hero-image img{

width:100%;
animation:float 4s infinite;

}

@keyframes float{

50%{
transform:translateY(-18px);
}

}

section{

padding:90px 8%;

}

.title{

text-align:center;
font-size:42px;
margin-bottom:60px;
color:#00ffff;

}

.cards{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:30px;

}

.card{

background:rgba(255,255,255,.08);
backdrop-filter:blur(12px);
padding:30px;
border-radius:20px;
transition:.4s;

}

.card:hover{

transform:translateY(-10px);
box-shadow:0 20px 40px rgba(0,255,255,.25);

}

.card h2{

margin-bottom:20px;
color:#00ffff;

}

.card ul{

padding-left:20px;

}

.card li{

margin:12px 0;

}

.stats{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:30px;

}

.stat{

background:rgba(255,255,255,.08);
padding:40px;
border-radius:20px;
text-align:center;

}

.stat h1{

font-size:55px;
color:#00ffff;

}

.search{

display:flex;
justify-content:center;
gap:15px;
margin-top:40px;

}

.search input{

width:500px;
padding:18px;
border:none;
border-radius:40px;
font-size:18px;

}

.materials{

display:grid;
grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
gap:25px;

}

.material{

background:rgba(255,255,255,.08);
padding:25px;
border-radius:20px;

}

.material h3{

margin-bottom:15px;
color:#00ffff;

}

.material button{

margin-top:15px;

}

.contact{

display:grid;
grid-template-columns:1fr 1fr;
gap:40px;

}

.contact form{

background:rgba(255,255,255,.08);
padding:35px;
border-radius:20px;

}

.contact input,
.contact textarea{

width:100%;
padding:15px;
margin:15px 0;
border:none;
border-radius:10px;
font-size:16px;

}

footer{

text-align:center;
padding:35px;
background:#08131d;

}

@media(max-width:900px){

.hero{

flex-direction:column;
text-align:center;

}

.hero-text,.hero-image{

width:100%;

}

.hero-image{

margin-top:40px;

}

.contact{

grid-template-columns:1fr;

}

.search{

flex-direction:column;

}

.search input{

width:100%;

}

nav{

display:none;

}

}

</style>

</head>

<body>

<header>

<div class="logo">📚 Infinity Library</div>

<nav>

<a href="#">Home</a>
<a href="#services">Services</a>
<a href="#materials">Materials</a>
<a href="#contact">Contact</a>

</nav>

<button class="btn">Login</button>

</header>

<div class="hero">

<div class="hero-text">

<h1>Smart <span>Library Management</span><br>System</h1>

<p>


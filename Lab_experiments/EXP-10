<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>StyleHub | Premium Fashion Store</title>

<style>

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:Arial,Helvetica,sans-serif;
}

body{
background:#f8f8f8;
color:#333;
}

header{
background:#111;
padding:18px 8%;
display:flex;
justify-content:space-between;
align-items:center;
position:sticky;
top:0;
z-index:100;
}

header h2{
color:#FFD700;
}

nav a{
color:white;
text-decoration:none;
margin:0 15px;
font-weight:bold;
}

nav a:hover{
color:#FFD700;
}

.hero{
height:90vh;
background:linear-gradient(rgba(0,0,0,.55),rgba(0,0,0,.55)),
url("https://images.unsplash.com/photo-1496747611176-843222e1e57c?w=1600") center/cover;
display:flex;
justify-content:center;
align-items:center;
text-align:center;
color:white;
}

.hero h1{
font-size:60px;
margin-bottom:20px;
}

.hero p{
font-size:22px;
margin-bottom:30px;
}

button{
padding:14px 35px;
border:none;
background:#FFD700;
font-weight:bold;
border-radius:30px;
cursor:pointer;
}

section{
padding:70px 8%;
}

.title{
text-align:center;
font-size:40px;
margin-bottom:40px;
color:#111;
}

.stats{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
gap:20px;
}

.stat{
background:white;
padding:30px;
text-align:center;
border-radius:12px;
box-shadow:0 5px 15px rgba(0,0,0,.1);
}

.stat h2{
font-size:38px;
color:#FFD700;
}

.categories{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:20px;
}

.cat{
background:white;
padding:30px;
border-left:6px solid #FFD700;
box-shadow:0 5px 15px rgba(0,0,0,.1);
}

.products{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:25px;
}

.product{
background:white;
border-radius:12px;
overflow:hidden;
box-shadow:0 8px 20px rgba(0,0,0,.1);
}

.product img{
width:100%;
height:260px;
object-fit:cover;
}

.product div{
padding:20px;
}

.product h3{
margin-bottom:10px;
}

.product button{
width:100%;
margin-top:15px;
}

.dashboard{
display:grid;
grid-template-columns:1fr 1fr;
gap:30px;
}

.panel{
background:white;
padding:30px;
border-radius:15px;
box-shadow:0 5px 15px rgba(0,0,0,.1);
}

.panel h2{
margin-bottom:20px;
color:#111;
}

.panel ul{
padding-left:20px;
}

.panel li{
margin:10px 0;
}

.contact{
background:#111;
color:white;
padding:50px;
border-radius:15px;
text-align:center;
}

footer{
background:black;
color:white;
text-align:center;
padding:20px;
margin-top:40px;
}

@media(max-width:900px){

.hero h1{
font-size:40px;
}

.dashboard{
grid-template-columns:1fr;
}

}

</style>

</head>

